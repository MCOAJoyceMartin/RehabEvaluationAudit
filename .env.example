# Copy to .env.local (gitignored) for local builds, or set the same two
# values as GitHub Actions repository secrets ONEDRIVE_RELAY_URL /
# ONEDRIVE_RELAY_SECRET for the GitHub Pages deploy — see
# docs/POWER_AUTOMATE_SETUP.md for how to get these values from your
# Power Automate flow.
#
# Leaving both blank is fine: the "Save to OneDrive" button simply doesn't
# render if no relay URL is configured.

# The "When an HTTP request is received" URL from your Power Automate flow.
VITE_ONEDRIVE_RELAY_URL=

# Any random string you choose. Sent with every request and checked by a
# Condition step in the flow before it does anything, as a basic deterrent
# against random hits on the public URL — NOT real security (see the
# comment in src/config/integrations.ts for why).
VITE_ONEDRIVE_RELAY_SECRET=
