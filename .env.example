# Copy to .env.local (gitignored) for local builds, or set the same two
# values as GitHub Actions repository secrets SAVE_SCRIPT_URL /
# SAVE_SCRIPT_SECRET for the GitHub Pages deploy — see
# docs/POWER_AUTOMATE_SETUP.md for how to get these values from your
# Google Apps Script deployment.
#
# Leaving both blank is fine: the "Save to OneDrive" button simply doesn't
# render if no script URL is configured.

# The Web App URL from your deployed Google Apps Script (Deploy > Manage
# deployments > Web app > URL). Ends in /exec.
VITE_SAVE_SCRIPT_URL=

# Any random string you choose. Sent with every request and checked at the
# top of the Apps Script before it does anything, as a basic deterrent
# against random hits on the public URL — NOT real security (see the
# comment in src/config/integrations.ts for why).
VITE_SAVE_SCRIPT_SECRET=
